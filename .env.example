PORT=3000
HOST=0.0.0.0
BASE_URL=https://admin.amarpet.com/api/v1
MCP_PATH=/mcp

# Keys that MCP clients must present via the x-api-key header to connect.
# Supports: single value, comma-separated, or JSON array.
# Example: CLIENT_API_KEYS=key1,key2
# Leave empty to disable auth (open server — not recommended for production).
CLIENT_API_KEYS=your-secret-key-here

# Key(s) used to authenticate with the upstream Amarpet API (round-robin rotation).
# Falls back to CLIENT_API_KEYS if not set.
UPSTREAM_API_KEY=upstream-api-key-here

# Legacy — used as fallback for both CLIENT_API_KEYS and UPSTREAM_API_KEY.
# API_KEY=alamin899
